# Demo mode saves data in this browser until the backend is configured.
VITE_DEMO_MODE=true

DATABASE_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_API_KEY=replace-with-a-different-random-secret-at-least-32-characters-long
APP_URL=https://your-vercel-domain.example
API_PORT=3001
CLIENT_ORIGIN=http://localhost:8080

# Only needed to remove all accounts from the old Supabase Auth project:
# SUPABASE_URL=https://<project-id>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-secret>

# Set this on the frontend hosting provider when the API is hosted separately:
# VITE_API_URL=https://your-api-domain.example
